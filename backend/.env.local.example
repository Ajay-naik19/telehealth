# Local PostgreSQL (create this database and its application tables first)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/telehealth

# Generate distinct, long random values before use.
ACCESS_TOKEN_SECRET=replace-with-a-local-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-local-refresh-secret

PORT=10000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:10000
