{
  "name": "telehealth-fullstack",
  "version": "1.0.0",
  "description": "TeleHealth Production Application",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --dns-result-order=ipv4first src/server.js",
    "dev": "nodemon src/server.js",
    "local:backend": "node scripts/local-backend-preflight.js && nodemon src/server.js",
    "local:frontend": "npm --prefix telehealth-frontend run local:dev",
    "local:free-ports": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p=Get-NetTCPConnection -State Listen -LocalPort 3000,10000 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if($p){$p|ForEach-Object{Stop-Process -Id $_ -Force}; Write-Output 'Stopped processes on ports 3000/10000.'} else {Write-Output 'No listeners on ports 3000/10000.'}\"",
    "test-env": "node src/test-env.js",
    "prod": "NODE_ENV=production node src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.39.3",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-winston": "^4.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "redis": "^5.10.0",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
